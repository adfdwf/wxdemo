* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
    font-size: 13px;
    color: #1f2329;
}

QWidget#RootWindow {
    background: #f5f5f5;
    border: 1px solid #d0d0d0;
}

QFrame#TitleBar {
    background: #f7f7f7;
    border-bottom: 1px solid #e6e6e6;
}

QLabel#WindowTitle {
    color: #59616f;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#WindowButton {
    border: none;
    background: transparent;
    color: #59616f;
    border-radius: 0;
    font-size: 14px;
}

QPushButton#WindowButton:hover {
    background: #e8e8e8;
}

QPushButton#WindowButton:pressed {
    background: #d8d8d8;
}

QPushButton#CloseButton:hover {
    background: #e81123;
    color: white;
}

QPushButton#CloseButton:pressed {
    background: #c50f1f;
    color: white;
}

QFrame#NavigationBar {
    background: #2e2e2e;
    border: none;
}

QPushButton#NavButton, QPushButton#AvatarButton {
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #a9a9a9;
    font-size: 20px;
}

QPushButton#NavButton:hover, QPushButton#AvatarButton:hover {
    background: #3d3d3d;
    color: #f1f1f1;
}

QPushButton#NavButton:pressed, QPushButton#AvatarButton:pressed {
    background: #4b4b4b;
}

QPushButton#NavButton[active="true"] {
    color: #07c160;
    background: #3a3a3a;
}

QLabel#BadgeLabel {
    background: #fa5151;
    color: white;
    min-width: 16px;
    min-height: 16px;
    border-radius: 8px;
    font-size: 10px;
    font-weight: bold;
}

QFrame#MiddlePane {
    background: #ededed;
    border-right: 1px solid #d7d7d7;
}

QLineEdit#SearchEdit {
    background: #dbdbdb;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 7px 10px;
    selection-background-color: #07c160;
}

QLineEdit#SearchEdit:focus {
    background: #ffffff;
    border: 1px solid #cfcfcf;
}

QListWidget#ConversationList, QListWidget#ContactList, QListWidget#FavoriteList {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#ConversationList::item, QListWidget#ContactList::item, QListWidget#FavoriteList::item {
    border: none;
}

QListWidget#ConversationList::item:selected {
    background: #d6d6d6;
}

QPushButton#RoundButton {
    background: #dcdcdc;
    border: none;
    border-radius: 4px;
    font-size: 18px;
}

QPushButton#RoundButton:hover {
    background: #cfcfcf;
}

QPushButton#RoundButton:pressed {
    background: #bfbfbf;
}

QFrame#ChatHeader {
    background: #f5f5f5;
    border-bottom: 1px solid #e7e7e7;
}

QLabel#ChatTitle {
    font-size: 18px;
    font-weight: 600;
    color: #111111;
}

QPushButton#HeaderButton, QPushButton#ToolButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    color: #5f646d;
    font-size: 18px;
}

QPushButton#HeaderButton:hover, QPushButton#ToolButton:hover {
    background: #e8e8e8;
}

QPushButton#HeaderButton:pressed, QPushButton#ToolButton:pressed {
    background: #d8d8d8;
}

QScrollArea#MessageArea {
    background: #f5f5f5;
    border: none;
}

QWidget#MessageViewport {
    background: #f5f5f5;
}

QFrame#IncomingBubble {
    background: #ffffff;
    border: 1px solid #e9e9e9;
    border-radius: 8px;
}

QFrame#OutgoingBubble {
    background: #95ec69;
    border: 1px solid #86df5d;
    border-radius: 8px;
}

QLabel#MessageMeta {
    color: #9a9a9a;
    font-size: 11px;
}

QLabel#MessageText {
    font-size: 14px;
    line-height: 150%;
    color: #111111;
}

QFrame#InputPanel {
    background: #f5f5f5;
    border-top: 1px solid #e7e7e7;
}

QTextEdit#MessageEditor {
    border: none;
    background: #f5f5f5;
    selection-background-color: #07c160;
    font-size: 14px;
}

QPushButton#SendButton {
    background: #07c160;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 7px 18px;
    font-weight: 600;
}

QPushButton#SendButton:hover {
    background: #06ad56;
}

QPushButton#SendButton:pressed {
    background: #05964b;
}

QPushButton#SendButton:disabled {
    background: #d6d6d6;
    color: #8d8d8d;
}

QFrame#InfoPanel, QFrame#SidePanel {
    background: #ffffff;
    border-left: 1px solid #e4e4e4;
}

QLabel#SectionTitle {
    color: #888888;
    font-size: 12px;
    font-weight: 600;
}

QMenu {
    background: white;
    border: 1px solid #d6d6d6;
    padding: 6px;
}

QMenu::item {
    padding: 7px 30px 7px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #f0f0f0;
}

QDialog {
    background: #ffffff;
}

QPushButton#PrimaryButton {
    background: #07c160;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 18px;
}

QPushButton#PrimaryButton:hover {
    background: #06ad56;
}

QPushButton#SecondaryButton {
    background: #f2f2f2;
    border: 1px solid #d8d8d8;
    border-radius: 5px;
    padding: 8px 18px;
}
